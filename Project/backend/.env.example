# PostgreSQL connection string (asyncpg driver for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/learnai

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=learnai

# JWT configuration
JWT_SECRET=change-me-to-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application settings
APP_ENV=development
